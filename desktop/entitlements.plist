<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Wails runs a WKWebView in-process. Under the hardened runtime the JIT
       and the unsigned-memory pages WebKit needs are denied by default, and the
       app dies at startup with no useful error. These three are the minimum
       for an embedded WebView; without them notarisation passes and the app
       still crashes on first launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- The app opens brewkeg.dev in the user's browser and writes the user's own
       tool configs; it makes no outbound connections of its own beyond the
       gateway. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>